{
  "rules": {
    "users": {
      ".indexOn": ["calToken"],
      "$uid": {
        // Your own data, OR your partner's — but only when BOTH sides of the
        // link agree: your linkedTo points at them AND their linkedPartner
        // points back at you. Both fields are written together by the
        // linkPartner Cloud Function, so you can't gain access by pointing
        // your own linkedTo at a stranger.
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('linkedTo').val() === $uid && data.child('linkedPartner').val() === auth.uid))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('linkedTo').val() === $uid && data.child('linkedPartner').val() === auth.uid))"
      }
    },
    "waitlist": {
      // The coming-soon page's email box (coming-soon.html). Unauthenticated
      // by necessity — signing in is the exact thing that page takes away.
      //
      // No client can READ the list, only the Firebase console can, so
      // whoever finds the page cannot harvest everyone who signed up.
      ".read": false,
      "$entry": {
        // Create-only. An entry that exists can never be edited or deleted
        // from a client, so the worst an abusive bot can manage is adding
        // junk rows next to the real ones — never destroying them.
        ".write": "!data.exists() && newData.hasChildren(['email','ts'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 254 && newData.val().matches(/^[^@]+@[^@]+[.][^@]+$/)"
        },
        // Server clock, not the client's — a caller cannot backdate or
        // forward-date their own signup.
        "ts": { ".validate": "newData.val() === now" },
        // Nothing else gets stored. Keeps the page honest about collecting
        // an email and nothing more, whatever the client tries to send.
        "$other": { ".validate": false }
      }
    },
    "dataGaps": {
      // What the Agent could not answer, for the owner to read in the
      // Firebase console and nowhere else. Same shape of trust as
      // "waitlist" above: any signed-in client may add a row, no client
      // may ever read one back.
      //
      // Deliberately holds NO question text, NO paraphrase and NO uid.
      // "eleven questions hit an area with no crime data" is the finding
      // the roadmap needs; which eleven adds nothing and would turn a
      // counter into personal data needing a lawful basis, a declared
      // purpose and a retention policy. Aggregate by construction is the
      // cheapest way to stay on the right side of that — you cannot leak
      // what you never held. The validation below is what keeps it that
      // way even if a future client tries to send more.
      ".read": false,
      "$entry": {
        // Append-only, like the waitlist: a row that exists can never be
        // edited or deleted from a client, so the worst anyone can do is
        // add noise beside the real rows rather than destroy them.
        ".write": "auth != null && !data.exists() && newData.hasChildren(['area','ts'])",
        "area": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        // The dimensions we held nothing on, as a short list of known-ish
        // names. Capped so this cannot become a channel for free text.
        "missing": {
          "$i": { ".validate": "newData.isString() && newData.val().length <= 60" },
          ".validate": "newData.hasChildren() || newData.val() === null"
        },
        // Whether the answer had to fall back to the model's own knowledge.
        "fellBack": { ".validate": "newData.isBoolean()" },
        // Server clock, not the client's.
        "ts": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "households": {
      "$hid": {
        // Read the whole household (profile + who's in it) once you're a
        // member — this cascades to every child, including members and
        // ownerUid, so the app can show "who's in this household" too.
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        "profile": {
          // One of the two things a client can actually write here. members
          // and ownerUid have NO .write rule anywhere in this subtree, and
          // RTDB denies by default when nothing grants access — so they're
          // only ever set by createHousehold/joinHousehold (admin rights,
          // bypasses rules entirely), never by a client claiming its own
          // membership. Same reasoning as linkPartner above.
          ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).val() === true"
        },
        "verdicts": {
          // What the household thought of the areas it visited. Same
          // membership test as the profile: anyone in the household can
          // write, because the whole point is that both people rate and
          // each prompts the other (docs/learning-loop.md). Reading is
          // already covered by the household-wide .read above.
          //
          // These are personal data about a household's movements — where
          // they went and when. They stay inside the household and are
          // never exposed to anyone else; anything that ever informs
          // another household's suggestions has to be aggregated first.
          ".write": "auth != null && root.child('households').child($hid).child('members').child(auth.uid).val() === true"
        }
      }
    },
    "householdInvites": {
      "$code": {
        // Same shape as invites/ above, generalised: a code just claims "I
        // made this, and I'm actually in the household it points at" —
        // redemption (and the up-to-4 cap) is enforced server-side in
        // joinHousehold, not by this rule.
        ".read": "auth != null && data.child('createdBy').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid && root.child('households').child(newData.child('householdId').val()).child('members').child(auth.uid).val() === true) || (data.child('createdBy').val() === auth.uid && !newData.exists()))"
      }
    }
  }
}
